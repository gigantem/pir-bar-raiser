{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/pir-interview.schema.json",
  "title": "PIR Owner Interview",
  "description": "One question program for a PIR owner, generated by tools/generate_pir_interview.py from a gap report. Questions are grouped by template section in the deck's writing order; each carries the validator finding it closes, the question from catalogs/pir-rule-questions.yaml and the section guidance from catalogs/pir-section-expectations.yaml. The schema owns shape; tools/pir_interview.py owns the semantics (sequential ids, ascending writing order, counts that match).",
  "type": "object",
  "required": [
    "id",
    "packet",
    "packet_id",
    "packet_status",
    "round",
    "status",
    "generated_by",
    "owner",
    "facilitator",
    "source_artifacts",
    "instructions",
    "counts",
    "sections",
    "response_template",
    "after_answers"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*-I[0-9]{2}$",
      "description": "The packet id (or its file stem when the packet has no valid id) followed by -I and the two-digit round."
    },
    "packet": {
      "type": "string",
      "minLength": 3,
      "description": "Path of the packet the interview was generated from, repo-relative when inside the repository."
    },
    "packet_id": { "type": ["string", "null"] },
    "packet_status": {
      "type": "string",
      "enum": ["draft", "in_team_review", "in_go_review", "published", "unknown"],
      "description": "The packet's own status at generation time; unknown when the packet carries no valid status."
    },
    "round": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["answers_required", "nothing_to_ask"]
    },
    "generated_by": { "type": "string", "const": "tools/generate_pir_interview.py" },
    "owner": {
      "type": "string",
      "minLength": 3,
      "description": "The PIR owner from the packet, or HUMAN_CONFIRM_PIR_OWNER when the packet does not name one."
    },
    "facilitator": {
      "type": "string",
      "minLength": 3,
      "description": "Who conducts the interview. The tool cannot know this, so it is generated as HUMAN_CONFIRM_FACILITATOR and replaced before the interview is used."
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 3 },
          "role": {
            "type": "string",
            "enum": ["pir-packet", "gap-report", "section-expectations", "rule-questions"]
          }
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "counts": {
      "type": "object",
      "required": ["questions", "blocking", "advisory", "sections"],
      "additionalProperties": false,
      "properties": {
        "questions": { "type": "integer", "minimum": 0 },
        "blocking": { "type": "integer", "minimum": 0 },
        "advisory": { "type": "integer", "minimum": 0 },
        "sections": { "type": "integer", "minimum": 0 }
      }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "response_template": {
      "type": "object",
      "required": ["title", "fields"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "guidance"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 3 },
              "guidance": { "type": "string", "minLength": 3 }
            }
          }
        }
      }
    },
    "after_answers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    }
  },
  "if": { "properties": { "status": { "const": "answers_required" } } },
  "then": { "properties": { "sections": { "minItems": 1 } } },
  "else": { "properties": { "sections": { "maxItems": 0 } } },
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "key",
        "title",
        "template_section",
        "writing_order",
        "expectation",
        "common_mistakes",
        "example",
        "interview_prompt",
        "questions"
      ],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 3 },
        "title": { "type": "string", "minLength": 3 },
        "template_section": { "type": "string", "minLength": 1 },
        "writing_order": { "type": "integer", "minimum": 0 },
        "expectation": { "type": "string", "minLength": 20 },
        "common_mistakes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "example": { "type": "string", "minLength": 20 },
        "interview_prompt": { "type": "string", "minLength": 20 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "rule",
        "severity",
        "blocking",
        "path",
        "finding",
        "ask",
        "answer_shape",
        "applies_to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^Q-[0-9]{3}$" },
        "rule": { "type": "string", "pattern": "^PIR-[A-Z0-9-]+$" },
        "severity": { "type": "string", "enum": ["error", "warning"] },
        "blocking": {
          "type": "boolean",
          "description": "True for an error-severity finding: the packet cannot pass the gate until it is answered."
        },
        "path": {
          "type": "string",
          "description": "The validator's path for the finding ($.section[i].field), or empty when the finding has none."
        },
        "finding": { "type": "string", "minLength": 3 },
        "ask": { "type": "string", "minLength": 10 },
        "answer_shape": { "type": "string", "minLength": 10 },
        "applies_to": { "type": "string", "minLength": 3 }
      }
    }
  }
}
